{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": ["custom.regex"],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^Dockerfile$"],
      "matchStrings": [
        "ARG BUILD_FROM=ghcr\\.io/muthur-command/base:(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "docker",
      "packageNameTemplate": "muthur-command/base",
      "registryUrlTemplate": "https://ghcr.io"
    },
    {
      "customType": "regex",
      "fileMatch": ["^\\.github/workflows/builder\\.yml$"],
      "matchStrings": [
        "cosign-base-verify: ghcr\\.io/muthur-command/base:(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "docker",
      "packageNameTemplate": "muthur-command/base",
      "registryUrlTemplate": "https://ghcr.io"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["muthur-command/base"],
      "groupName": "docker-base-base",
      "commitMessageTopic": "muthur-command/base image",
      "commitMessageExtra": "to {{newVersion}}",
      "versioning": "loose"
    }
  ]
}
